# Copy to .env.local (gitignored). Never commit real keys: this repo is public.
# Server-side only. Transcript correction, translation and context cards (/api/translate).
ANTHROPIC_API_KEY=
# Server-side only. Nearby food places (/api/places), Places API (New) enabled on the key.
GOOGLE_MAPS_API_KEY=
# Optional model overrides (defaults in lib/server/anthropic.ts).
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5-20251001
