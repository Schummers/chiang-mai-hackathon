# Copy to .env.local (gitignored). Never commit real keys: this repo is public.
# Turn service used by the UI: "mock" (scripted Khao Soi scenario) or "api" (real back-end, ticket #12).
NEXT_PUBLIC_TURN_SERVICE=mock
# Server-side only. Needed when NEXT_PUBLIC_TURN_SERVICE=api, locally too (npm run dev calls the real routes).
# Get a key at aistudio.google.com; production uses the one set in Vercel.
GEMINI_API_KEY=
# Optional model overrides (defaults in lib/server/gemini.ts).
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite
# GEMINI_TURN_MODEL=gemini-3.6-flash
