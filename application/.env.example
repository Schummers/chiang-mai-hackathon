# Copy to .env.local (gitignored). Never commit real keys: this repo is public.
# Turn service used by the UI: "mock" (scripted Khao Soi scenario) or "api" (real back-end, ticket #12).
NEXT_PUBLIC_TURN_SERVICE=mock
# Server-side only. Translation and context cards (/api/translate).
ANTHROPIC_API_KEY=
# Server-side only. Nearby food places (/api/places), Places API (New) enabled on the key.
GOOGLE_MAPS_API_KEY=
# Server-side only. Photos (/api/photo) and the transcription fallback for browsers without speech recognition.
# Get a key at aistudio.google.com; production uses the one set in Vercel.
GEMINI_API_KEY=
# Optional model overrides (defaults in lib/server/anthropic.ts and lib/server/gemini.ts).
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5-20251001
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite
# GEMINI_TURN_MODEL=gemini-3.6-flash
